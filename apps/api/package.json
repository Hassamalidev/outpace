{
  "name": "@forge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge AI Fastify backend",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
