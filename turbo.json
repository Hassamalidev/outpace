{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "LOG_LEVEL",
    "APP_VERSION",
    "API_URL",
    "ENCRYPTION_KEY",
    "DATABASE_URL",
    "DIRECT_URL",
    "DATABASE_CONNECTION_LIMIT",
    "DATABASE_POOL_TIMEOUT",
    "REDIS_URL",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "OPENAI_API_KEY",
    "APOLLO_API_KEY",
    "HUNTER_API_KEY",
    "CLEARBIT_API_KEY",
    "ZEROBOUNCE_API_KEY",
    "MILLIONVERIFIER_API_KEY",
    "SNOV_USER_ID",
    "SNOV_SECRET",
    "SKRAPP_API_KEY",
    "ROCKETREACH_API_KEY",
    "LUSHA_API_KEY",
    "CONTACTOUT_API_KEY",
    "ENROW_API_KEY",
    "FINDYMAIL_API_KEY",
    "BUILTWITH_API_KEY",
    "RAPIDAPI_KEY",
    "BOMBORA_API_KEY",
    "CRUNCHBASE_API_KEY",
    "BING_SEARCH_API_KEY",
    "PRODUCTIONHUNT_TOKEN",
    "TWITTER_BEARER_TOKEN",
    "NAMECHEAP_API_USER",
    "NAMECHEAP_API_KEY",
    "CLOUDFLARE_API_TOKEN",
    "CLOUDFLARE_ZONE_ID",
    "INBOUND_EMAIL_DOMAIN",
    "TRACKING_BASE_URL",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "CALCOM_CLIENT_ID",
    "CALCOM_CLIENT_SECRET",
    "CALENDLY_CLIENT_ID",
    "CALENDLY_CLIENT_SECRET",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "TWILIO_PHONE_NUMBER",
    "HUBSPOT_CLIENT_ID",
    "HUBSPOT_CLIENT_SECRET",
    "SALESFORCE_CLIENT_ID",
    "SALESFORCE_CLIENT_SECRET",
    "SLACK_CLIENT_ID",
    "SLACK_CLIENT_SECRET",
    "SLACK_DEPLOY_WEBHOOK_URL",
    "CLOUDFLARE_R2_ACCOUNT_ID",
    "CLOUDFLARE_R2_ACCESS_KEY_ID",
    "CLOUDFLARE_R2_SECRET_ACCESS_KEY",
    "CLOUDFLARE_R2_BUCKET",
    "CLOUDFLARE_R2_PUBLIC_URL",
    "RESEND_API_KEY",
    "ELEVENLABS_API_KEY",
    "SENTRY_DSN",
    "AXIOM_TOKEN",
    "AXIOM_ORG_ID",
    "POSTHOG_KEY",
    "TYPESENSE_HOST",
    "TYPESENSE_API_KEY",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "ADMIN_SECRET",
    "NEXT_PUBLIC_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".output/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": ["coverage/**"]
    }
  }
}
